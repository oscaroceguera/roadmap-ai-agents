{
  "name": "vault-rag",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "ablation": "dotenv run -q -f ${ENV:-.env} -- tsx evals/ablation.ts",
    "ingest": "dotenv run -q -f ${ENV:-.env} -- tsx src/ingest.ts",
    "chunk:stats": "dotenv run -q -f ${ENV:-.env} -- tsx src/chunk/stats.ts",
    "ask": "dotenv run -q -f ${ENV:-.env} -- tsx src/cli.ts ask",
    "chat": "dotenv run -q -f ${ENV:-.env} -- tsx src/cli.ts chat",
    "test": "vitest run test/",
    "eval": "dotenv run -q -f ${ENV:-.env} -- vitest run evals/ --silent=false",
    "eval:retrieval": "dotenv run -q -f ${ENV:-.env} -- vitest run evals/retrieval.test.ts --silent=false",
    "eval:security": "dotenv run -q -f ${ENV:-.env} -- vitest run evals/ --silent=false -t security",
    "try": "dotenv run -q -f ${ENV:-.env} -- tsx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.92",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "ai": "^7.0.138",
    "dotenv": "^18.0.7",
    "gray-matter": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
