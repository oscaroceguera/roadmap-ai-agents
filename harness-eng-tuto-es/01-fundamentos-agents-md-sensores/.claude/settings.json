{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-check.sh",
            "timeout": 120,
            "statusMessage": "Corriendo pnpm check..."
          }
        ]
      }
    ]
  }
}
